            }
          },
          "dataMapping": {
            "categoryKey": [
              {
                "id": "reviews.decision"
              }
            ],
            "valueKey": [
              {
                "id": "reviews.review_id",
                "aggregation": "count"
              }
            ]
          }
        },
        "chart_quality": {
          "type": "bar-chart-grouped",
          "format": {
            "title": {
              "enabled": true,
              "text": "Human vs AI-agent sellers: verification quality"
            }
          },
          "dataMapping": {
            "categoryKey": [
              {
                "id": "pacts.seller_type"
              }
