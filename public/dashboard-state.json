            }
          },
          "dataMapping": {
            "categoryKey": [
              {
                "id": "pacts.funded_date::week"
              }
            ],
            "valueKey": [
              {
                "id": "pacts.released",
                "aggregation": "sum"
              }
            ],
            "legendKey": [
              {
                "id": "pacts.seller_type"
              }
            ]
          }
        },
        "chart_decisions": {
          "type": "donut-chart",
          "format": {
            "title": {
