# ---- Anthropic (Claude) ----
# Get a key at https://console.anthropic.com/  — without it Clause runs in "simulated AI" mode.
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# ---- PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox) ----
# This app belongs to your sandbox BUSINESS account: it is the seller / payee.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Sandbox PERSONAL account = the buyer. You log in with it in the PayPal popup.
# Only used by the optional end-to-end browser test (npm run e2e) and shown as a hint in the UI.
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=
# Sandbox BUSINESS account email (displayed as the payee in the UI; optional)
PAYPAL_BUSINESS_EMAIL=

# ---- App ----
PORT=3000
# Public URL of this app (used for PayPal return/cancel redirects)
APP_BASE_URL=http://localhost:3000
# Minimum arbiter confidence required before money moves automatically (0-1)
AUTO_RELEASE_MIN_CONFIDENCE=0.75

# ---- AG Studio (optional) ----
# Without a key AG Studio runs in trial mode (all features, watermark). Request a trial key at ag-grid.com/studio.
AG_STUDIO_LICENSE_KEY=

# ---- Render (optional) ----
# Run the AI agents as Render Workflow tasks instead of in-process.
RENDER_WORKFLOW_SLUG=
RENDER_API_KEY=
# Shared secret for the maintenance sweep endpoint (the Render cron job sends it)
CRON_SECRET=
